{
  "name": "@opencode-ai/es-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Electron shell for es-app",
  "author": "OpenCode",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/dev.ts",
    "start": "electron .",
    "preview": "node scripts/preview.mjs",
    "package": "electron-builder --dir --publish never",
    "test": "bun test src",
    "test:electron": "node test/smoke.mjs",
    "test:links": "node test/external-links.mjs",
    "test:header": "node test/native-header.mjs",
    "test:draft-restart": "node test/draft-restart.mjs",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "@opencode-ai/es-app": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "vite": "catalog:"
  },
  "dependencies": {
    "eventsource": "3.0.7",
    "ws": "8.21.0"
  },
  "build": {
    "appId": "ai.opencode.es-desktop",
    "productName": "Editspace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  }
}
